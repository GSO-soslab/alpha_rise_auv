<launch>
    <arg name="robot_name" default="alpha_rise"/>

    <!-- Bring up the Blueprint Oculus FLS -->
    <include file="$(find alpha_rise_bringup)/launch/include/blueprint_oculus_fls.launch.xml">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>

    <!-- Bring up the MSIS Ping360 -->
    <include file="$(find alpha_rise_bringup)/launch/include/bluerobotics_ping360.launch.xml">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>

</launch>
