<launch>

    <arg name="robot_name" default="alpha_rise"/>

    <node ns="$(arg robot_name)" pkg="joy_thruster_map" type="joy_thruster_map.py" 
        name="joy_thruster_map_node" output="screen">
        <!--Sub-->
        <remap from="joy" to="helm/teleop/joy"/>
        <!--Pub-->
        <remap from="surge_thruster" to="control/thruster/surge"/>
    </node>

</launch>