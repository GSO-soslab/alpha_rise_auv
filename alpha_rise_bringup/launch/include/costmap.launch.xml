<launch>

    <arg name="robot_name" default="changeme"/>
    <arg name="is_sim" default="false"/>

    <group if="$(eval arg('is_sim') == false)">
        <node ns="$(arg robot_name)" pkg="move_base" type="move_base" name="move_base" output="screen">
            <!-- <param name="use_sim_true" value="true"/> -->
            <!-- <param name="base_global_planner" value="navfn/NavfnROS"/>
            <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/> -->
            <rosparam file="$(find alpha_rise_config)/config/local_costmap_params.yaml" command="load"/>
            <rosparam file="$(find alpha_rise_config)/config/global_costmap_params.yaml" command="load"/>
            <rosparam file="$(find alpha_rise_config)/config/common_costmap_params.yaml" command="load" ns="global_costmap"/>
            <rosparam file="$(find alpha_rise_config)/config/common_costmap_params.yaml" command="load" ns="local_costmap"/>
        </node>
    </group>

    <group if="$(eval arg('is_sim') == true)">
        <node ns="$(arg robot_name)" pkg="move_base" type="move_base" name="move_base" output="screen">
            <!-- <param name="use_sim_true" value="true"/> -->
            <!-- <param name="base_global_planner" value="navfn/NavfnROS"/>
            <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/> -->
            <rosparam file="$(find alpha_rise_config)/config/local_costmap_params.yaml" command="load"/>
            <rosparam file="$(find alpha_rise_config)/config/global_costmap_params.yaml" command="load"/>
            <rosparam file="$(find alpha_rise_config)/config/common_costmap_params_sim.yaml" command="load" ns="global_costmap"/>
            <rosparam file="$(find alpha_rise_config)/config/common_costmap_params_sim.yaml" command="load" ns="local_costmap"/>
        </node>
    </group>
    
</launch>