<launch>
    <arg name="robot_name" default="alpha_rise"/>

    <!-- Bring up the Waypoint_admin -->
    <include file="$(find alpha_rise_bringup)/launch/include/wp_admin.launch.xml">
        <arg name="robot_name" value="$(arg robot_name)"/>
    </include>


</launch>